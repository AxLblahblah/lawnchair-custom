+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+@OptIn(ExperimentalAnimationApi::class)
+fun NavGraphBuilder.backupGraph(route: String) {
+    preferenceGraph(route, { BackupPreferences() })
+}
+
+@OptIn(ExperimentalAnimationApi::class)
+@Composable
+fun BackupPreferences() {
+    val context = LocalContext.current
+    val scope = rememberCoroutineScope()
+    var pendingRestoreUri by remember { mutableStateOf<Uri?>(null) }
+
+    val backupLauncher = rememberLauncherForActivityResult(
+        ActivityResultContracts.CreateDocument()
+    ) { uri ->
+        if (uri != null) {
+            scope.launch {
+                val success = runSafely { BackupUtils.createBackup(context, uri) }
+                withContext(Dispatchers.Main) {
+                    Toast.makeText(
+                        context,
+                        context.getString(if (success) R.string.backup_created else R.string.backup_failed),
+                        Toast.LENGTH_SHORT
+                    ).show()
+                }
+            }
+        }
+    }
+
+    val restoreLauncher = rememberLauncherForActivityResult(
+        ActivityResultContracts.OpenDocument()
+    ) { uri ->
+        if (uri != null) {
+            pendingRestoreUri = uri
+        }
+    }
+
+    pendingRestoreUri?.let { uri ->
+        AlertDialog(
+            onDismissRequest = { pendingRestoreUri = null },
+            title = { Text(stringResource(id = R.string.restore_confirm_title)) },
+            text = { Text(stringResource(id = R.string.restore_confirm_message)) },
+            confirmButton = {
+                TextButton(onClick = {
+                    pendingRestoreUri = null
+                    scope.launch {
+                        val success = runSafely { BackupUtils.restoreBackup(context, uri) }
+                        withContext(Dispatchers.Main) {
+                            Toast.makeText(
+                                context,
+                                context.getString(if (success) R.string.restore_done else R.string.restore_failed),
+                                Toast.LENGTH_SHORT
+                            ).show()
+                        }
+                    }
+                }) {
+                    Text(stringResource(id = R.string.restore_button))
+                }
+            },
+            dismissButton = {
+                TextButton(onClick = { pendingRestoreUri = null }) {
+                    Text(stringResource(id = android.R.string.cancel))
+                }
+            }
+        )
+    }
+
+    PreferenceLayout(label = stringResource(id = R.string.backup_restore_label)) {
+        PreferenceGroup(isFirstChild = true) {
+            GridOverridesPreview(
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .padding(horizontal = 16.dp, vertical = 8.dp),
+                updateGridOptions = {}
+            )
+        }
+        PreferenceGroup {
+            PreferenceTemplate(
+                title = { Text(stringResource(id = R.string.backup_info)) }
+            )
+        }
+        PreferenceGroup {
+            Column {
+                Button(
+                    onClick = { backupLauncher.launch(BackupUtils.suggestedFileName()) },
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .padding(horizontal = 16.dp, vertical = 4.dp),
+                ) {
+                    Text(stringResource(id = R.string.backup_button))
+                }
+                Spacer(modifier = Modifier.height(4.dp))
+                Button(
+                    onClick = {
+                        restoreLauncher.launch(
+                            arrayOf("application/zip", "application/octet-stream", "*/*")
+                        )
+                    },
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .padding(horizontal = 16.dp, vertical = 4.dp),
+                ) {
+                    Text(stringResource(id = R.string.restore_button))
+                }
+            }
+        }
+    }
+}
+
+private inline fun runSafely(block: () -> Unit): Boolean {
+    return try {
+        block()
+        true
+    } catch (t: Throwable) {
+        false
+    }
+}
