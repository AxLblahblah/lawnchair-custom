index f77b29c..2d30e9f 100644
--- a/lawnchair/src/app/lawnchair/theme/color/ColorTokenUtils.kt
+++ b/lawnchair/src/app/lawnchair/theme/color/ColorTokenUtils.kt
@@ -1,4 +1,30 @@
 package app.lawnchair.theme.color
 
+import android.content.Context
+import app.lawnchair.preferences2.PreferenceManager2
+import app.lawnchair.theme.UiColorMode
+import dev.kdrag0n.colorkt.Color
+import dev.kdrag0n.monet.theme.ColorScheme
+
 fun ColorToken.setAlpha(alpha: Float) = SetAlphaColorToken(this, alpha)
 fun ColorToken.setLStar(lStar: Double) = SetLStarColorToken(this, lStar)
+
+class WithContextColorToken(
+    private val token: ColorToken,
+    private val transform: ColorToken.(Context) -> ColorToken,
+) : ColorToken {
+
+    override fun resolve(context: Context, scheme: ColorScheme, uiColorMode: UiColorMode): Color {
+        return transform(token, context).resolve(context, scheme, uiColorMode)
+    }
+}
+
+fun ColorToken.withContext(transform: ColorToken.(Context) -> ColorToken) =
+    WithContextColorToken(this, transform)
+
+fun ColorToken.withPreferences(
+    transform: ColorToken.(PreferenceManager2) -> ColorToken,
+) = withContext { context ->
+    val prefs = PreferenceManager2.getInstance(context)
+    transform(this, prefs)
+}
