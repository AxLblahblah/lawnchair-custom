+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package app.lawnchair.backup
+
+import android.content.Context
+import android.database.sqlite.SQLiteDatabase
+import android.net.Uri
+import com.android.launcher3.LauncherFiles
+import com.android.launcher3.util.IOUtils
+import app.lawnchair.util.restartLauncher
+import java.io.File
+import java.io.IOException
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+import java.util.zip.ZipEntry
+import java.util.zip.ZipInputStream
+import java.util.zip.ZipOutputStream
+
+/**
+ * Creates and restores full launcher backups.
+ *
+ * A backup is a plain .zip file containing:
+ *  - databases/launcher.db (+ wal/shm if present)  -> homescreen layout, folders, widgets, hotseat
+ *  - databases/preferences (+ wal/shm if present)  -> custom icon overrides (Room)
+ *  - datastore/preferences.preferences_pb          -> PreferenceManager2 (new preference system)
+ *  - shared_prefs (all XML files)                  -> old preference system + launcher prefs
+ */
+object BackupUtils {
+
+    const val MANIFEST_ENTRY = "manifest.txt"
+    const val LAUNCHER_DB_ENTRY = "databases/launcher.db"
+    const val ICON_DB_ENTRY = "databases/preferences"
+    const val DATASTORE_ENTRY = "datastore/preferences.preferences_pb"
+    const val SHARED_PREFS_PREFIX = "shared_prefs/"
+
+    fun suggestedFileName(): String {
+        val format = SimpleDateFormat("yyyy-MM-dd_HH-mm", Locale.US)
+        return "lawnchair-backup_${format.format(Date())}.zip"
+    }
+
+    private fun dataDir(context: Context) = context.applicationInfo.dataDir
+
+    fun createBackup(context: Context, uri: Uri) {
+        val output = context.contentResolver.openOutputStream(uri)
+            ?: throw IOException("Could not open output stream")
+        output.use { out ->
+            ZipOutputStream(out).use { zip ->
+                putStringEntry(zip, MANIFEST_ENTRY, manifestContent())
+
+                val databasesDir = File(dataDir(context), "databases")
+                // Flush WAL content into the main db files so the copies are complete.
+                checkpointDb(File(databasesDir, "launcher.db"))
+                checkpointDb(File(databasesDir, "preferences"))
+
+                putFileEntry(zip, databasesDir, "launcher.db", LAUNCHER_DB_ENTRY)
+                putFileEntry(zip, databasesDir, "launcher.db-wal", "$LAUNCHER_DB_ENTRY-wal")
+                putFileEntry(zip, databasesDir, "launcher.db-shm", "$LAUNCHER_DB_ENTRY-shm")
+                putFileEntry(zip, databasesDir, "preferences", ICON_DB_ENTRY)
+                putFileEntry(zip, databasesDir, "preferences-wal", "$ICON_DB_ENTRY-wal")
+                putFileEntry(zip, databasesDir, "preferences-shm", "$ICON_DB_ENTRY-shm")
+
+                val datastoreDir = File(context.filesDir, "datastore")
+                putFileEntry(zip, datastoreDir, "preferences.preferences_pb", DATASTORE_ENTRY)
+
+                val sharedPrefsDir = File(dataDir(context), "shared_prefs")
+                sharedPrefsDir.listFiles { file -> file.name.endsWith(".xml") }?.forEach { file ->
+                    putFileEntry(zip, sharedPrefsDir, file.name, SHARED_PREFS_PREFIX + file.name)
+                }
+            }
+        }
+    }
+
+    /**
+     * Restores the given backup and restarts the launcher process so every
+     * component picks up the restored files.
+     */
+    fun restoreBackup(context: Context, uri: Uri) {
+        val input = context.contentResolver.openInputStream(uri)
+            ?: throw IOException("Could not open input stream")
+
+        // Read everything into memory first so a broken file cannot wipe the live data.
+        data class Entry(val name: String, val bytes: ByteArray)
+        val entries = mutableListOf<Entry>()
+        input.use { raw ->
+            ZipInputStream(raw).use { zip ->
+                while (true) {
+                    val entry = zip.nextEntry ?: break
+                    if (!entry.isDirectory) {
+                        entries.add(Entry(entry.name, IOUtils.toByteArray(zip)))
+                    }
+                    zip.closeEntry()
+                }
+            }
+        }
+        if (entries.none { it.name == LAUNCHER_DB_ENTRY }) {
+            throw IOException("Not a valid Lawnchair backup file")
+        }
+
+        val databasesDir = File(dataDir(context), "databases")
+        val datastoreDir = File(context.filesDir, "datastore")
+        val sharedPrefsDir = File(dataDir(context), "shared_prefs")
+        databasesDir.mkdirs()
+        datastoreDir.mkdirs()
+        sharedPrefsDir.mkdirs()
+
+        entries.forEach { entry ->
+            val target: File = when {
+                entry.name == LAUNCHER_DB_ENTRY -> File(databasesDir, "launcher.db")
+                entry.name == "$LAUNCHER_DB_ENTRY-wal" -> File(databasesDir, "launcher.db-wal")
+                entry.name == "$LAUNCHER_DB_ENTRY-shm" -> File(databasesDir, "launcher.db-shm")
+                entry.name == ICON_DB_ENTRY -> File(databasesDir, "preferences")
+                entry.name == "$ICON_DB_ENTRY-wal" -> File(databasesDir, "preferences-wal")
+                entry.name == "$ICON_DB_ENTRY-shm" -> File(databasesDir, "preferences-shm")
+                entry.name == DATASTORE_ENTRY -> File(datastoreDir, "preferences.preferences_pb")
+                entry.name.startsWith(SHARED_PREFS_PREFIX) ->
+                    File(sharedPrefsDir, entry.name.removePrefix(SHARED_PREFS_PREFIX))
+                else -> return@forEach
+            }
+            target.parentFile?.mkdirs()
+            target.writeBytes(entry.bytes)
+        }
+
+        // Stale wal/shm files from the *current* database must not be applied on top
+        // of the restored main db files.
+        if (entries.none { it.name == "$LAUNCHER_DB_ENTRY-wal" }) File(databasesDir, "launcher.db-wal").delete()
+        if (entries.none { it.name == "$LAUNCHER_DB_ENTRY-shm" }) File(databasesDir, "launcher.db-shm").delete()
+        if (entries.none { it.name == "$ICON_DB_ENTRY-wal" }) File(databasesDir, "preferences-wal").delete()
+        if (entries.none { it.name == "$ICON_DB_ENTRY-shm" }) File(databasesDir, "preferences-shm").delete()
+
+        restartLauncher(context)
+    }
+
+    private fun manifestContent(): String {
+        val format = SimpleDateFormat("yyyy-MM-dd HH:mm", Locale.US)
+        return "lawnchair-backup v1\ncreated: ${format.format(Date())}\n"
+    }
+
+    private fun putStringEntry(zip: ZipOutputStream, name: String, content: String) {
+        zip.putNextEntry(ZipEntry(name))
+        zip.write(content.toByteArray(Charsets.UTF_8))
+        zip.closeEntry()
+    }
+
+    private fun putFileEntry(zip: ZipOutputStream, dir: File, fileName: String, entryName: String) {
+        val file = File(dir, fileName)
+        if (!file.exists()) return
+        zip.putNextEntry(ZipEntry(entryName))
+        file.inputStream().use { it.copyTo(zip) }
+        zip.closeEntry()
+    }
+
+    private fun checkpointDb(file: File) {
+        if (!file.exists()) return
+        try {
+            val db = SQLiteDatabase.openDatabase(file.absolutePath, null, SQLiteDatabase.OPEN_READWRITE)
+            try {
+                db.rawQuery("PRAGMA wal_checkpoint(TRUNCATE)", null).use { it.moveToFirst() }
+            } finally {
+                db.close()
+            }
+        } catch (_: Throwable) {
+            // Best effort; the plain file copy still usually produces a valid backup.
+        }
+    }
+}
