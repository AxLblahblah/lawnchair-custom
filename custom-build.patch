diff --git a/lawnchair/src/app/lawnchair/qsb/WorkspaceSearchBar.kt b/lawnchair/src/app/lawnchair/qsb/WorkspaceSearchBar.kt
new file mode 100644
index 0000000..7fb48fb
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/qsb/WorkspaceSearchBar.kt
@@ -0,0 +1,45 @@
+package app.lawnchair.qsb
+
+import android.content.Context
+import android.graphics.drawable.PaintDrawable
+import android.util.AttributeSet
+import android.widget.FrameLayout
+import android.widget.ImageView
+import android.widget.TextView
+import androidx.core.view.ViewCompat
+import app.lawnchair.launcherNullable
+import com.android.launcher3.R
+import com.android.launcher3.util.Themes
+
+class WorkspaceSearchBar(context: Context, attrs: AttributeSet?) : FrameLayout(context, attrs) {
+
+    private lateinit var inner: FrameLayout
+    private lateinit var pillBackground: PaintDrawable
+
+    override fun onFinishInflate() {
+        super.onFinishInflate()
+
+        inner = ViewCompat.requireViewById(this, R.id.inner)
+        val searchIcon = ViewCompat.requireViewById<ImageView>(this, R.id.search_icon)
+        val searchText = ViewCompat.requireViewById<TextView>(this, R.id.search_text)
+
+        val fillColor = Themes.getAttrColor(context, R.attr.qsbFillColor)
+        val textColor = Themes.getAttrColor(context, android.R.attr.textColorPrimary)
+        pillBackground = PaintDrawable(fillColor)
+        inner.background = pillBackground
+        searchIcon.setColorFilter(textColor)
+        searchText.setTextColor(textColor)
+
+        setOnClickListener {
+            context.launcherNullable?.startSearch("", false, null, true)
+        }
+    }
+
+    override fun onLayout(changed: Boolean, left: Int, top: Int, right: Int, bottom: Int) {
+        super.onLayout(changed, left, top, right, bottom)
+        val pillHeight = inner.height
+        if (pillHeight > 0) {
+            pillBackground.setCornerRadius(pillHeight / 2f)
+        }
+    }
+}
