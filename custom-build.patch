+import android.content.pm.LauncherApps
+import android.appwidget.AppWidgetManager
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.content.res.Configuration
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.drawable.Drawable
+import android.os.Process
+import androidx.core.graphics.ColorUtils
+import com.android.launcher3.LauncherSettings
+import com.android.launcher3.R
+import com.android.launcher3.Utilities
+
+object FolderWidgetData {
+
+    const val PREFS_FILE = "folder_widget_config"
+    const val EXTRA_WIDGET_ID = "appWidgetId"
+    const val EXTRA_FOLDER_ID = "folderId"
+    const val EXTRA_COMPONENT = "component"
+    const val ACTION_LAUNCH_APP = "app.lawnchair.folderwidget.ACTION_LAUNCH_APP"
+    const val FOLDER_ID_ALL_APPS = -1L
+
+    data class FolderEntry(val id: Long, val title: String)
+
+    data class AppEntry(
+        val component: ComponentName,
+        val label: String,
+        val icon: Bitmap?,
+    )
+
+    fun getConfigPrefs(context: Context) =
+        context.getSharedPreferences(PREFS_FILE, Context.MODE_PRIVATE)
+
+    fun getFolderId(context: Context, appWidgetId: Int): Long {
+        return getConfigPrefs(context).getLong("widget_${appWidgetId}_folderId", FOLDER_ID_ALL_APPS)
+    }
+
+    fun setFolderId(context: Context, appWidgetId: Int, folderId: Long) {
+        getConfigPrefs(context).edit()
+            .putLong("widget_${appWidgetId}_folderId", folderId)
+            .apply()
+    }
+
+    /** Lists all folders currently on the homescreen. */
+    fun queryFolders(context: Context): List<FolderEntry> {
+        val result = mutableListOf<FolderEntry>()
+        try {
+            context.contentResolver.query(
+                LauncherSettings.Favorites.CONTENT_URI,
+                arrayOf(LauncherSettings.Favorites._ID, LauncherSettings.Favorites.TITLE),
+                "${LauncherSettings.Favorites.ITEM_TYPE} = ${LauncherSettings.Favorites.ITEM_TYPE_FOLDER}",
+                null,
+                null,
+            )?.use { cursor ->
+                val idIndex = cursor.getColumnIndexOrThrow(LauncherSettings.Favorites._ID)
+                val titleIndex = cursor.getColumnIndexOrThrow(LauncherSettings.Favorites.TITLE)
+                while (cursor.moveToNext()) {
+                    val id = cursor.getLong(idIndex)
+                    val title = if (titleIndex >= 0 && !cursor.isNull(titleIndex)) {
+                        cursor.getString(titleIndex)
+                    } else {
+                        "Folder"
+                    }
+                    if (title != null) {
+                        result.add(FolderEntry(id, title))
+                    }
+                }
+            }
+        } catch (_: Throwable) {
+        }
+        return result
+    }
+
+    /** Lists the apps inside the given folder, or every app when folderId == ALL_APPS. */
+    fun queryApps(context: Context, folderId: Long): List<AppEntry> {
+        if (folderId == FOLDER_ID_ALL_APPS) {
+            return queryAllApps(context)
+        }
+        val components = mutableListOf<ComponentName>()
+        try {
+            context.contentResolver.query(
+                LauncherSettings.Favorites.CONTENT_URI,
+                arrayOf(LauncherSettings.Favorites.INTENT),
+                "${LauncherSettings.Favorites.CONTAINER} = ? AND " +
+                    "${LauncherSettings.Favorites.ITEM_TYPE} = ${LauncherSettings.Favorites.ITEM_TYPE_APPLICATION}",
+                arrayOf(folderId.toString()),
+                null,
+            )?.use { cursor ->
+                val intentIndex = cursor.getColumnIndexOrThrow(LauncherSettings.Favorites.INTENT)
+                while (cursor.moveToNext()) {
+                    if (cursor.isNull(intentIndex)) continue
+                    val intentText = cursor.getString(intentIndex) ?: continue
+                    try {
+                        val intent = Intent.parseUri(intentText, 0)
+                        val component = intent.component ?: continue
+                        if (component.packageName != context.packageName) {
+                            components.add(component)
+                        }
+                    } catch (_: Throwable) {
+                    }
+                }
+            }
+        } catch (_: Throwable) {
+        }
+        return components.distinct().mapNotNull { resolveApp(context, it) }
+    }
+
+    private fun queryAllApps(context: Context): List<AppEntry> {
+        val launcherApps = context.getSystemService(LauncherApps::class.java) ?: return emptyList()
+        val apps = mutableListOf<AppEntry>()
+        try {
+            launcherApps.getActivityList(null, Process.myUserHandle()).forEach { activity ->
+                try {
+                    val component = activity.componentName
+                    val label = activity.label?.toString() ?: component.shortClassName
+                    apps.add(AppEntry(component, label, drawableToBitmap(activity.getBadgedIcon(0), context)))
+                } catch (_: Throwable) {
+                }
+            }
+        } catch (_: Throwable) {
+        }
+        return apps.sortedBy { it.label.lowercase() }
+    }
+
+    private fun resolveApp(context: Context, component: ComponentName): AppEntry? {
+        return try {
+            val pm = context.packageManager
+            val info = pm.getActivityInfo(component, 0)
+            val label = info.loadLabel(pm)?.toString() ?: component.shortClassName
+            AppEntry(component, label, drawableToBitmap(info.loadIcon(pm), context))
+        } catch (_: Throwable) {
+            null
+        }
+    }
+
+    fun drawableToBitmap(drawable: Drawable?, context: Context): Bitmap? {
+        drawable ?: return null
+        return try {
+            val size = (48 * context.resources.displayMetrics.density).toInt()
+            val bitmap = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888)
+            val canvas = Canvas(bitmap)
+            drawable.setBounds(0, 0, size, size)
+            drawable.draw(canvas)
+            bitmap
+        } catch (_: Throwable) {
+            null
+        }
+    }
+
+    /** Material You dynamic colors from the system wallpaper palette (API 31+). */
+    data class MaterialYouColors(val container: Int, val title: Int, val label: Int)
+
+    fun resolveColors(context: Context): MaterialYouColors {
+        val isDark = (context.resources.configuration.uiMode and Configuration.UI_MODE_NIGHT_MASK) ==
+            Configuration.UI_MODE_NIGHT_YES
+        if (Utilities.ATLEAST_S) {
+            return if (isDark) {
+                MaterialYouColors(
+                    container = ColorUtils.setAlphaComponent(
+                        context.getColor(android.R.color.system_accent1_700), 230),
+                    title = context.getColor(android.R.color.system_accent1_100),
+                    label = context.getColor(android.R.color.system_accent1_100),
+                )
+            } else {
+                MaterialYouColors(
+                    container = ColorUtils.setAlphaComponent(
+                        context.getColor(android.R.color.system_accent1_100), 230),
+                    title = context.getColor(android.R.color.system_accent1_900),
+                    label = context.getColor(android.R.color.system_accent1_900),
+                )
+            }
+        }
+        // Pre-S fallback: neutral translucent container.
+        return if (isDark) {
+            MaterialYouColors(0xE6202021.toInt(), 0xFFE0E0E0.toInt(), 0xFFE0E0E0.toInt())
+        } else {
+            MaterialYouColors(0xE6F1F1F1.toInt(), 0xFF202124.toInt(), 0xFF202124.toInt())
+        }
+    }
+
+    fun getWidgetIds(context: Context): IntArray {
+        val manager = AppWidgetManager.getInstance(context)
+        return manager.getAppWidgetIds(ComponentName(context, FolderWidgetProvider::class.java))
+    }
+}
