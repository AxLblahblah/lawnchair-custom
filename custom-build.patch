+
+package app.lawnchair.folderwidget
+
+import android.content.pm.LauncherApps
+import android.app.PendingIntent
+import android.appwidget.AppWidgetManager
+import android.appwidget.AppWidgetProvider
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.net.Uri
+import android.os.Build
+import android.os.Process
+import android.util.TypedValue
+import android.widget.RemoteViews
+import com.android.launcher3.R
+
+/**
+ * A scrollable widget that shows the apps of a chosen homescreen folder
+ * (or all apps) inside a Material You styled container.
+ */
+class FolderWidgetProvider : AppWidgetProvider() {
+
+    override fun onUpdate(context: Context, appWidgetManager: AppWidgetManager, appWidgetIds: IntArray) {
+        appWidgetIds.forEach { id -> updateWidget(context, appWidgetManager, id) }
+    }
+
+    override fun onDeleted(context: Context, appWidgetIds: IntArray) {
+        appWidgetIds.forEach { id ->
+            FolderWidgetData.getConfigPrefs(context).edit()
+                .remove("widget_${id}_folderId")
+                .apply()
+        }
+    }
+
+    override fun onReceive(context: Context, intent: Intent) {
+        super.onReceive(context, intent)
+        if (intent.action == FolderWidgetData.ACTION_LAUNCH_APP) {
+            val component = intent.getStringExtra(FolderWidgetData.EXTRA_COMPONENT)
+            if (component != null) {
+                try {
+                    val cn = ComponentName.unflattenFromString(component)
+                    if (cn != null) {
+                        context.getSystemService(LauncherApps::class.java)
+                            ?.startMainActivity(cn, Process.myUserHandle(), null, null)
+                    }
+                } catch (_: Throwable) {
+                }
+            }
+        }
+    }
+
+    companion object {
+
+        @JvmStatic
+        fun updateWidget(context: Context, manager: AppWidgetManager, appWidgetId: Int) {
+            val colors = FolderWidgetData.resolveColors(context)
+
+            val views = RemoteViews(context.packageName, R.layout.folder_widget)
+            views.setInt(R.id.folder_widget_root, "setBackgroundColor", colors.container)
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+                views.setViewOutlinePreferredRadius(
+                    R.id.folder_widget_root, 24f, TypedValue.COMPLEX_UNIT_DIP)
+            }
+            views.setBoolean(R.id.folder_widget_root, "setClipToOutline", true)
+            views.setTextColor(R.id.folder_widget_title, colors.title)
+
+            val folderId = FolderWidgetData.getFolderId(context, appWidgetId)
+            val title = if (folderId == FolderWidgetData.FOLDER_ID_ALL_APPS) {
+                context.getString(R.string.folder_widget_all_apps)
+            } else {
+                FolderWidgetData.queryFolders(context)
+                    .firstOrNull { it.id == folderId }?.title
+                    ?: context.getString(R.string.folder_widget_failed_to_load)
+            }
+            views.setTextViewText(R.id.folder_widget_title, title)
+
+            // Tapping the header brings the launcher forward.
+            val homeIntent = Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_HOME)
+                .setPackage(context.packageName)
+            views.setOnClickPendingIntent(
+                R.id.folder_widget_title,
+                PendingIntent.getActivity(
+                    context, appWidgetId, homeIntent,
+                    PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
+                )
+            )
+
+            // Scrollable grid backed by the RemoteViewsService.
+            val adapterIntent = Intent(context, FolderWidgetService::class.java)
+                .putExtra(AppWidgetManager.EXTRA_APPWIDGET_ID, appWidgetId)
+                .setData(Uri.parse("folderwidget://$appWidgetId"))
+            views.setRemoteAdapter(R.id.folder_widget_grid, adapterIntent)
+
+            val launchFlags = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+                PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_MUTABLE
+            } else {
+                PendingIntent.FLAG_UPDATE_CURRENT
+            }
+            val launchTemplate = PendingIntent.getBroadcast(
+                context, 0,
+                Intent(context, FolderWidgetProvider::class.java)
+                    .setAction(FolderWidgetData.ACTION_LAUNCH_APP),
+                launchFlags
+            )
+            views.setPendingIntentTemplate(R.id.folder_widget_grid, launchTemplate)
+
+            manager.updateAppWidget(appWidgetId, views)
+            manager.notifyAppWidgetViewDataChanged(appWidgetId, R.id.folder_widget_grid)
+        }
+
+        /** Refreshes every folder widget (called when the layout or its apps change). */
+        @JvmStatic
+        fun updateAll(context: Context) {
+            val manager = AppWidgetManager.getInstance(context)
+            val ids = FolderWidgetData.getWidgetIds(context)
+            if (ids.isEmpty()) return
+            ids.forEach { id -> updateWidget(context, manager, id) }
+        }
+    }
+}
